{
  "name": "hackathon-chatapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "vite",
    "seed": "node server/seed.js",
    "test": "node --experimental-test-module-mocks --test \"tests/*.test.js\" \"tests/unit/*.test.js\"",
    "test:watch": "node --experimental-test-module-mocks --test --watch \"tests/*.test.js\" \"tests/unit/*.test.js\"",
    "demo:seed": "node scripts/seed-dashboard-demo.js",
    "demo:clean": "node scripts/seed-dashboard-demo.js --clean",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "db:clear": "node scripts/clear-db.js",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.5.3",
    "socket.io-client": "^4.5.3",
    "vue": "^3.2.45",
    "vue-router": "^4.1.6",
    "vuetify": "^3.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "vite": "^4.0.0"
  }
}
